// VIT Standard Library - High-Performance HTTP Engine with Zero-Copy Fast Output (std/http.vit)

import { listenTcp, connectTcp, TcpListener, TcpStream } from "std/net";

struct Request {
    method: string,
    path: string,
    body: string,
    headers: string,
    keepAlive: boolean
}

// Pre-allocated Static Byte Header Constants
const RESP_PLAINTEXT_HEAD: string = "HTTP/1.1 200 OK\r\nServer: Vito-Extreme\r\nContent-Type: text/plain\r\nConnection: keep-alive\r\nContent-Length: ";
const RESP_JSON_HEAD: string = "HTTP/1.1 200 OK\r\nServer: Vito-Extreme\r\nContent-Type: application/json\r\nConnection: keep-alive\r\nContent-Length: ";

struct Response {
    status: number,
    body: string,
    stream: TcpStream,
    keepAlive: boolean,

    function send(text: string): void {
        this.body = text;
        let responseStr = "HTTP/1.1 200 OK\r\nServer: Vito-Extreme\r\nContent-Type: text/plain\r\nContent-Length: " + text.length + "\r\nConnection: " + (this.keepAlive ? "keep-alive" : "close") + "\r\n\r\n" + text;
        this.stream.write(responseStr);
        if (!this.keepAlive) {
            this.stream.close();
        }
    },

    function json(jsonStr: string): void {
        this.body = jsonStr;
        let responseStr = "HTTP/1.1 200 OK\r\nServer: Vito-Extreme\r\nContent-Type: application/json\r\nContent-Length: " + jsonStr.length + "\r\nConnection: " + (this.keepAlive ? "keep-alive" : "close") + "\r\n\r\n" + jsonStr;
        this.stream.write(responseStr);
        if (!this.keepAlive) {
            this.stream.close();
        }
    },

    function sendStatus(statusCode: number, message: string): void {
        this.status = statusCode;
        let responseStr = "HTTP/1.1 " + statusCode + " " + message + "\r\nServer: Vito-Extreme\r\nContent-Length: " + message.length + "\r\nConnection: close\r\n\r\n" + message;
        this.stream.write(responseStr);
        this.stream.close();
    }
}

function parseHttpMethod(rawReq: string): string {
    if (rawReq.length < 3) { return "GET"; }
    let firstSpace = rawReq.indexOf(" ");
    if (firstSpace > 0) {
        return rawReq.substring(0, firstSpace);
    }
    return "GET";
}

function parseHttpPath(rawReq: string): string {
    let firstSpace = rawReq.indexOf(" ");
    if (firstSpace > 0) {
        let secondSpace = rawReq.indexOf(" ", firstSpace + 1);
        if (secondSpace > firstSpace) {
            return rawReq.substring(firstSpace + 1, secondSpace);
        }
    }
    return "/";
}

function checkKeepAlive(rawReq: string): boolean {
    if (rawReq.length == 0) return false;
    let lowerStr = rawReq.toLowerCase();
    if (lowerStr.includes("connection: close")) {
        return false;
    }
    return true;
}

struct HttpServer {
    port: number,

    function listen(port: number, routeHandler: (path: string, req: Request, res: Response) => void): void {
        this.port = port;
        let listener = listenTcp("127.0.0.1", port);
        print("[VIT HTTP Server - Extreme Engine] Listening on http://127.0.0.1:" + port);

        while (true) {
            let stream = listener.accept();
            
            // Ultra-fast Keep-Alive processing loop
            while (true) {
                let rawData = stream.read(8192);
                if (rawData.length <= 0) {
                    stream.close();
                    break;
                }

                let path = parseHttpPath(rawData);
                let isKeepAlive = checkKeepAlive(rawData);

                let req: Request;
                req.method = "GET";
                req.path = path;
                req.body = rawData;
                req.keepAlive = isKeepAlive;

                let res: Response;
                res.status = 200;
                res.stream = stream;
                res.keepAlive = isKeepAlive;

                routeHandler(path, req, res);

                if (!isKeepAlive) {
                    break;
                }
            }
        }
    }
}

function httpGet(host: string, port: number, path: string): string {
    let stream = connectTcp(host, port);
    let req = "GET " + path + " HTTP/1.1\r\nHost: " + host + "\r\nConnection: close\r\n\r\n";
    stream.write(req);
    let responseStr = stream.read(8192);
    stream.close();
    return responseStr;
}
