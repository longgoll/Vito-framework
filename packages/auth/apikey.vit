// Vito API Key Guard & Per-Client Rate Limit Package (vito/packages/auth/apikey.vit)
import { Request, Response } from "../src/vito.vit";
import { charAt } from "std/string";

struct ApiKeyItem {
    rawKey: string,
    keyPrefix: string,
    hashedKey: string,
    clientName: string,
    rateLimit: number,
    requestCount: number,
    active: boolean
}

struct ApiKeyStore {
    k0_prefix: string, k0_hash: string, k0_name: string, k0_limit: number, k0_count: number, k0_active: boolean,
    k1_prefix: string, k1_hash: string, k1_name: string, k1_limit: number, k1_count: number, k1_active: boolean,
    totalKeys: number,

    function init(): ApiKeyStore {
        this.k0_prefix = ""; this.k0_hash = ""; this.k0_name = ""; this.k0_limit = 100; this.k0_count = 0; this.k0_active = false;
        this.k1_prefix = ""; this.k1_hash = ""; this.k1_name = ""; this.k1_limit = 100; this.k1_count = 0; this.k1_active = false;
        this.totalKeys = 0;
        return this;
    },

    function registerKey(rawKey: string, prefix: string, hashVal: string, clientName: string, rateLimit: number): ApiKeyStore {
        if (!this.k0_active) {
            this.k0_prefix = prefix; this.k0_hash = hashVal; this.k0_name = clientName;
            this.k0_limit = rateLimit; this.k0_count = 0; this.k0_active = true;
        } else {
            if (!this.k1_active) {
                this.k1_prefix = prefix; this.k1_hash = hashVal; this.k1_name = clientName;
                this.k1_limit = rateLimit; this.k1_count = 0; this.k1_active = true;
            }
        }
        this.totalKeys = this.totalKeys + 1;
        return this;
    },

    function validateAndIncrement(hashVal: string): number {
        if (this.k0_active && this.k0_hash == hashVal) {
            if (this.k0_count >= this.k0_limit) { return 2; }
            this.k0_count = this.k0_count + 1;
            return 1;
        }
        if (this.k1_active && this.k1_hash == hashVal) {
            if (this.k1_count >= this.k1_limit) { return 2; }
            this.k1_count = this.k1_count + 1;
            return 1;
        }
        return 0;
    }
}

// 1. One-way API Key Hashing Function
function hashApiKey(rawKey: string): string {
    let hash = 16777619;
    let len = rawKey.length;
    let i = 0;
    while (i < len) {
        let code = charAt(rawKey, i);
        if (code == "a") { hash = hash * 31 + 97; }
        else {
            if (code == "k") { hash = hash * 31 + 107; }
            else {
                if (code == "_") { hash = hash * 31 + 95; }
                else { hash = hash * 31 + 120; }
            }
        }
        i = i + 1;
    }
    if (hash < 0) { hash = 0 - hash; }
    return "hash_apk_" + hash;
}

// 2. Key Generator (e.g. vk_live_abc123xyz)
function generateApiKey(prefix: string, seed: string): string {
    let hash = hashApiKey(seed);
    return prefix + "_" + hash;
}

function createApiKeyStore(): ApiKeyStore {
    let store: ApiKeyStore;
    store.init();
    return store;
}

// 3. API Key Guard Struct
struct ApiKeyGuard {
    store: ApiKeyStore,

    function init(s: ApiKeyStore): ApiKeyGuard {
        this.store = s;
        return this;
    },

    function handleRequest(req: Request, res: Response): boolean {
        let apiKey = req.header("X-API-Key");
        if (apiKey.length == 0) { apiKey = req.header("x-api-key"); }

        if (apiKey.length == 0) {
            res.setStatus(401).json("{\"error\":\"Unauthorized\",\"message\":\"Missing X-API-Key header\"}");
            return false;
        }

        let keyHash = hashApiKey(apiKey);
        let status = this.store.validateAndIncrement(keyHash);

        if (status == 0) {
            res.setStatus(401).json("{\"error\":\"Unauthorized\",\"message\":\"Invalid API Key\"}");
            return false;
        } else {
            if (status == 2) {
                res.setStatus(429).json("{\"error\":\"Too Many Requests\",\"message\":\"API Key rate limit quota exceeded\"}");
                return false;
            }
        }

        return true;
    }
}

function createApiKeyGuard(store: ApiKeyStore): ApiKeyGuard {
    let guard: ApiKeyGuard;
    guard.init(store);
    return guard;
}
