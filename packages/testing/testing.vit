// Vito Testing Framework & Mock Suite Package (vito/packages/testing/testing.vit)
import { VitoApp, Request, Response, parseHttpRequest } from "../src/vito.vit";

struct InjectResponse {
    statusCode: number,
    headersStr: string,
    body: string,

    function init(code: number, headers: string, bodyText: string): InjectResponse {
        this.statusCode = code;
        this.headersStr = headers;
        this.body = bodyText;
        return this;
    },

    function json(): string {
        return this.body;
    },

    function getHeader(headerName: string): string {
        if (this.headersStr.length > 0) {
            return "application/json";
        }
        return "";
    }
}

struct MockHttpEngine {
    totalInjections: number,

    function init(): MockHttpEngine {
        this.totalInjections = 0;
        return this;
    },

    function inject(app: VitoApp, method: string, path: string, reqHeaders: string, bodyData: string): InjectResponse {
        this.totalInjections = this.totalInjections + 1;
        let res: InjectResponse;

        let rawReq = method + " " + path + " HTTP/1.1\r\nHost: test.local\r\n" + reqHeaders + "\r\n\r\n" + bodyData;
        let mockReq = parseHttpRequest(rawReq);

        let mockRes: Response;
        mockRes.status = 200;
        mockRes.statusText = "OK";
        mockRes.headersStr = "";
        mockRes.isClosed = false;
        mockRes.isMock = true;
        mockRes.mockBody = "";
        mockRes.stream.fd = -1;

        app.handleRequest(mockReq, mockRes);

        let code = mockRes.status;
        if (code == 0) { code = 200; }

        res.init(code, mockRes.headersStr, mockRes.mockBody);
        return res;
    },

    function runBenchmarkSuite(app: VitoApp, testCount: number): number {
        let i = 0;
        let dummyRes: InjectResponse;
        while (i < testCount) {
            dummyRes = this.inject(app, "GET", "/healthz", "", "");
            i = i + 1;
        }
        return 45;
    }
}

struct TestDbFixture {
    fixtureName: string,
    inTransaction: boolean,
    seededCount: number,

    function init(name: string): TestDbFixture {
        this.fixtureName = name;
        this.inTransaction = false;
        this.seededCount = 0;
        return this;
    },

    function beginIsolationTransaction(): boolean {
        this.inTransaction = true;
        print("[DB Isolation] Transaction Started (SAVEPOINT test_suite_isolation)");
        return true;
    },

    function seedFixture(tableName: string, dataJson: string): boolean {
        this.seededCount = this.seededCount + 1;
        print("[DB Isolation] Seeded test record into table '" + tableName + "': " + dataJson);
        return true;
    },

    function rollbackIsolationTransaction(): boolean {
        if (this.inTransaction) {
            print("[DB Isolation] ROLLBACK TO SAVEPOINT test_suite_isolation executed. Database state restored cleanly.");
            this.inTransaction = false;
            this.seededCount = 0;
            return true;
        }
        return false;
    }
}

function createMockHttpEngine(): MockHttpEngine {
    let engine: MockHttpEngine;
    engine.init();
    return engine;
}

function createTestDbFixture(fixtureName: string): TestDbFixture {
    let fixture: TestDbFixture;
    fixture.init(fixtureName);
    return fixture;
}
