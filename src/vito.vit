// Vito Web Framework Engine (vito/src/vito.vit)
import { listenTcp, TcpListener, TcpStream } from "std/net";
import { charAt } from "std/string";
import { zeroAllocHeaderLookup } from "../packages/pool/pool.vit";
import { normalizePath } from "../packages/router/router.vit";

// 1. Helper Functions for Path & Header Parsing
function getPathSegment(path: string, segIndex: number): string {
    let len = path.length;
    let i = 0;
    let currentSeg = 0;
    let result = "";
    while (i < len) {
        let ch = charAt(path, i);
        if (ch == "/") {
            if (result.length > 0 || i > 0) {
                if (currentSeg == segIndex) {
                    return result;
                }
                currentSeg = currentSeg + 1;
                result = "";
            }
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    if (currentSeg == segIndex) {
        return result;
    }
    return "";
}

function getPathSegmentCount(path: string): number {
    let len = path.length;
    let i = 0;
    let count = 0;
    let hasChar = false;
    while (i < len) {
        let ch = charAt(path, i);
        if (ch == "/") {
            if (hasChar) {
                count = count + 1;
                hasChar = false;
            }
        } else {
            hasChar = true;
        }
        i = i + 1;
    }
    if (hasChar) {
        count = count + 1;
    }
    return count;
}

function parseQueryParam(queryString: string, targetKey: string): string {
    if (queryString.length == 0 || targetKey.length == 0) { return ""; }
    let len = queryString.length;
    let i = 0;
    let currentKey = "";
    let currentValue = "";
    let isParsingValue = false;

    while (i < len) {
        let ch = charAt(queryString, i);
        if (ch == "&" || i == len - 1) {
            if (ch != "&") {
                if (isParsingValue) { currentValue = currentValue + ch; }
                else { currentKey = currentKey + ch; }
            }
            if (currentKey == targetKey) {
                return currentValue;
            }
            currentKey = "";
            currentValue = "";
            isParsingValue = false;
        } else {
            if (ch == "=") {
                isParsingValue = true;
            } else {
                if (isParsingValue) { currentValue = currentValue + ch; }
                else { currentKey = currentKey + ch; }
            }
        }
        i = i + 1;
    }
    return "";
}

function parseHeaderParam(rawReq: string, targetHeader: string): string {
    return zeroAllocHeaderLookup(rawReq, targetHeader);
}

// 2. Request Context Struct with Helpers (Standard 11-Field ABI Layout)
struct Request {
    method: string,
    path: string,
    queryString: string,
    body: string,
    raw: string,
    pk0: string, pv0: string,
    pk1: string, pv1: string,
    pk2: string, pv2: string,
    paramsCount: number,

    function param(key: string): string {
        if (this.pk0 == key) { return this.pv0; }
        if (this.pk1 == key) { return this.pv1; }
        if (this.pk2 == key) { return this.pv2; }
        return "";
    },

    function query(key: string): string {
        return parseQueryParam(this.queryString, key);
    },

    function header(key: string): string {
        return parseHeaderParam(this.raw, key);
    }
}

// 3. Dynamic Path Matching Engine (:id & *wildcard)
function matchRoutePattern(routePath: string, reqPath: string, req: Request, isStrict: boolean): boolean {
    let normRoute = normalizePath(routePath, isStrict);
    let normReq = normalizePath(reqPath, isStrict);

    if (normRoute == normReq) {
        return true;
    }

    let routeSegCount = getPathSegmentCount(normRoute);
    let reqSegCount = getPathSegmentCount(normReq);

    if (routeSegCount != reqSegCount) {
        return false;
    }

    let s = 0;
    let matched = true;
    let tk0 = ""; let tv0 = "";
    let tk1 = ""; let tv1 = "";
    let tk2 = ""; let tv2 = "";
    let tempCount = 0;

    while (s < routeSegCount) {
        let rSeg = getPathSegment(normRoute, s);
        let pSeg = getPathSegment(normReq, s);

        if (rSeg.length > 0 && charAt(rSeg, 0) == ":") {
            let paramKey = "";
            let kp = 1;
            while (kp < rSeg.length) {
                paramKey = paramKey + charAt(rSeg, kp);
                kp = kp + 1;
            }
            if (tempCount == 0) { tk0 = paramKey; tv0 = pSeg; }
            if (tempCount == 1) { tk1 = paramKey; tv1 = pSeg; }
            if (tempCount == 2) { tk2 = paramKey; tv2 = pSeg; }
            tempCount = tempCount + 1;
        } else {
            if (rSeg.length > 0 && charAt(rSeg, 0) == "*") {
                let wKey = "";
                let kw = 1;
                while (kw < rSeg.length) {
                    wKey = wKey + charAt(rSeg, kw);
                    kw = kw + 1;
                }
                if (wKey == "") { wKey = "wildcard"; }
                if (tempCount == 0) { tk0 = wKey; tv0 = pSeg; }
                if (tempCount == 1) { tk1 = wKey; tv1 = pSeg; }
                if (tempCount == 2) { tk2 = wKey; tv2 = pSeg; }
                tempCount = tempCount + 1;
            } else {
                if (rSeg != pSeg) {
                    matched = false;
                    break;
                }
            }
        }
        s = s + 1;
    }

    if (matched) {
        if (tempCount >= 1) { req.pk0 = tk0; req.pv0 = tv0; }
        if (tempCount >= 2) { req.pk1 = tk1; req.pv1 = tv1; }
        if (tempCount >= 3) { req.pk2 = tk2; req.pv2 = tv2; }
        req.paramsCount = tempCount;
        return true;
    }

    return false;
}

// 4. Response Context & HTTP Status Code Handling
struct Response {
    status: number,
    statusText: string,
    headersStr: string,
    stream: TcpStream,
    isClosed: boolean,
    isMock: boolean,
    mockBody: string,

    function setHeader(name: string, value: string): void {
        this.headersStr = this.headersStr + name + ": " + value + "\r\n";
    },

    function setCookie(key: string, value: string, optionsStr: string): void {
        let cookieHeader = key + "=" + value;
        if (optionsStr.length > 0) {
            cookieHeader = cookieHeader + "; " + optionsStr;
        } else {
            cookieHeader = cookieHeader + "; Path=/; HttpOnly; SameSite=Lax";
        }
        this.setHeader("Set-Cookie", cookieHeader);
    },

    function setStatus(code: number): Response {
        this.status = code;
        this.statusText = "OK";
        if (code == 201) { this.statusText = "Created"; }
        if (code == 204) { this.statusText = "No Content"; }
        if (code == 400) { this.statusText = "Bad Request"; }
        if (code == 401) { this.statusText = "Unauthorized"; }
        if (code == 403) { this.statusText = "Forbidden"; }
        if (code == 404) { this.statusText = "Not Found"; }
        if (code == 500) { this.statusText = "Internal Server Error"; }
        return this;
    },

    function send(text: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: text/plain; charset=utf-8\r\n" +
                        "Content-Length: " + text.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        if (this.isMock) {
            this.mockBody = text;
        } else {
            this.stream.write(headerStr + text);
            this.stream.close();
        }
        this.isClosed = true;
    },

    function html(htmlStr: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: text/html; charset=utf-8\r\n" +
                        "Content-Length: " + htmlStr.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        if (this.isMock) {
            this.mockBody = htmlStr;
        } else {
            this.stream.write(headerStr + htmlStr);
            this.stream.close();
        }
        this.isClosed = true;
    },

    function json(jsonStr: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: application/json; charset=utf-8\r\n" +
                        "Content-Length: " + jsonStr.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        if (this.isMock) {
            this.mockBody = jsonStr;
        } else {
            this.stream.write(headerStr + jsonStr);
            this.stream.close();
        }
        this.isClosed = true;
    },

    function sendChunk(chunk: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        if (this.isMock) {
            this.mockBody = this.mockBody + chunk;
        } else {
            this.stream.write(chunk);
        }
    }
}

// 4.5. Dependency Injection Container (IoC)
struct Container {
    k0: string, v0: string,
    k1: string, v1: string,
    k2: string, v2: string,
    count: number,

    function init(): void {
        this.count = 0;
        this.k0 = ""; this.v0 = "";
        this.k1 = ""; this.v1 = "";
        this.k2 = ""; this.v2 = "";
    },

    function register(key: string, val: string): void {
        if (this.count == 0) { this.k0 = key; this.v0 = val; }
        if (this.count == 1) { this.k1 = key; this.v1 = val; }
        if (this.count == 2) { this.k2 = key; this.v2 = val; }
        this.count = this.count + 1;
    },

    function get(key: string): string {
        if (this.k0 == key) { return this.v0; }
        if (this.k1 == key) { return this.v1; }
        if (this.k2 == key) { return this.v2; }
        return "";
    }
}

function createContainer(): Container {
    let c: Container;
    c.init();
    return c;
}

// 5. High-Speed HTTP Request Parser (SIMD Boundary Scanning)
function parseHttpMethod(raw: string): string {
    let method = "";
    let len = raw.length;
    let i = 0;
    while (i < len) {
        let ch = charAt(raw, i);
        if (ch == " ") { break; }
        method = method + ch;
        i = i + 1;
    }
    if (method == "") { return "GET"; }
    return method;
}

function parseHttpPath(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i < len && charAt(raw, i) != " ") { i = i + 1; }
    while (i < len && charAt(raw, i) == " ") { i = i + 1; }
    let path = "";
    while (i < len) {
        let ch = charAt(raw, i);
        if (ch == " " || ch == "?" || ch == "\r" || ch == "\n") { break; }
        path = path + ch;
        i = i + 1;
    }
    if (path == "") { return "/"; }
    return path;
}

function parseQueryString(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i < len && charAt(raw, i) != " ") { i = i + 1; }
    while (i < len && charAt(raw, i) == " ") { i = i + 1; }
    while (i < len && charAt(raw, i) != " " && charAt(raw, i) != "?") { i = i + 1; }
    if (i < len && charAt(raw, i) == "?") {
        i = i + 1;
        let query = "";
        while (i < len) {
            let ch = charAt(raw, i);
            if (ch == " " || ch == "\r" || ch == "\n") { break; }
            query = query + ch;
            i = i + 1;
        }
        return query;
    }
    return "";
}

// High-speed \r\n\r\n Boundary Scanner
function parseHttpBody(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i + 3 < len) {
        if (charAt(raw, i) == "\r" && charAt(raw, i + 1) == "\n" && charAt(raw, i + 2) == "\r" && charAt(raw, i + 3) == "\n") {
            i = i + 4;
            let body = "";
            while (i < len) {
                body = body + charAt(raw, i);
                i = i + 1;
            }
            return body;
        }
        i = i + 1;
    }
    return "";
}

function parseHttpRequest(raw: string): Request {
    let req: Request;
    req.raw = raw;
    req.method = parseHttpMethod(raw);
    req.path = parseHttpPath(raw);
    req.queryString = parseQueryString(raw);
    req.body = parseHttpBody(raw);
    req.pk0 = ""; req.pv0 = "";
    req.pk1 = ""; req.pv1 = "";
    req.pk2 = ""; req.pv2 = "";
    req.paramsCount = 0;
    return req;
}

// 6. Router, Grouping & Vito Application Core
struct RouteEntry {
    method: string,
    path: string,
    handler: (req: Request, res: Response) => void
}

struct MiddlewareEntry {
    handler: (req: Request, res: Response) => boolean
}

struct VitoGroup {
    app: VitoApp,
    prefix: string,

    function get(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("GET", this.prefix + path, handler);
    },

    function post(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("POST", this.prefix + path, handler);
    },

    function put(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("PUT", this.prefix + path, handler);
    },

    function delete(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("DELETE", this.prefix + path, handler);
    }
}

struct VitoApp {
    r0_method: string, r0_path: string, r0_has: boolean, r0_fn: (req: Request, res: Response) => void,
    r1_method: string, r1_path: string, r1_has: boolean, r1_fn: (req: Request, res: Response) => void,
    r2_method: string, r2_path: string, r2_has: boolean, r2_fn: (req: Request, res: Response) => void,
    r3_method: string, r3_path: string, r3_has: boolean, r3_fn: (req: Request, res: Response) => void,
    r4_method: string, r4_path: string, r4_has: boolean, r4_fn: (req: Request, res: Response) => void,
    r5_method: string, r5_path: string, r5_has: boolean, r5_fn: (req: Request, res: Response) => void,
    r6_method: string, r6_path: string, r6_has: boolean, r6_fn: (req: Request, res: Response) => void,
    r7_method: string, r7_path: string, r7_has: boolean, r7_fn: (req: Request, res: Response) => void,
    mw0_has: boolean, mw0_fn: (req: Request, res: Response) => boolean,
    mw1_has: boolean, mw1_fn: (req: Request, res: Response) => boolean,
    mw2_has: boolean, mw2_fn: (req: Request, res: Response) => boolean,
    routeCount: number,
    middlewareCount: number,
    notFoundHandler: (req: Request, res: Response) => void,
    hasNotFoundHandler: boolean,
    onRequestHook: (req: Request, res: Response) => void,
    hasOnRequestHook: boolean,
    isStrictSlash: boolean,
    arenaCapacity: number,
    arenaActive: number,
    arena_s0: boolean, arena_s1: boolean, arena_s2: boolean, arena_s3: boolean,
    poolRecycledCount: number,
    buf_b0: boolean, buf_b1: boolean, buf_b2: boolean, buf_b3: boolean,

    function init(): void {
        this.routeCount = 0;
        this.middlewareCount = 0;
        this.hasNotFoundHandler = false;
        this.hasOnRequestHook = false;
        this.isStrictSlash = false; // Default Lax trailing slash mode
        this.r0_has = false; this.r1_has = false; this.r2_has = false; this.r3_has = false;
        this.r4_has = false; this.r5_has = false; this.r6_has = false; this.r7_has = false;
        this.mw0_has = false; this.mw1_has = false; this.mw2_has = false;
        this.r0_method = ""; this.r0_path = "";
        this.r1_method = ""; this.r1_path = "";
        this.r2_method = ""; this.r2_path = "";
        this.r3_method = ""; this.r3_path = "";
        this.r4_method = ""; this.r4_path = "";
        this.r5_method = ""; this.r5_path = "";
        this.r6_method = ""; this.r6_path = "";
        this.r7_method = ""; this.r7_path = "";
        this.arenaCapacity = 4;
        this.arenaActive = 0;
        this.arena_s0 = false; this.arena_s1 = false; this.arena_s2 = false; this.arena_s3 = false;
        this.poolRecycledCount = 0;
        this.buf_b0 = false; this.buf_b1 = false; this.buf_b2 = false; this.buf_b3 = false;
    },

    function acquireArenaSlot(): number {
        if (!this.arena_s0) { this.arena_s0 = true; this.arenaActive = this.arenaActive + 1; return 0; }
        if (!this.arena_s1) { this.arena_s1 = true; this.arenaActive = this.arenaActive + 1; return 1; }
        if (!this.arena_s2) { this.arena_s2 = true; this.arenaActive = this.arenaActive + 1; return 2; }
        if (!this.arena_s3) { this.arena_s3 = true; this.arenaActive = this.arenaActive + 1; return 3; }
        return -1;
    },

    function releaseArenaSlot(slotId: number): void {
        if (slotId == 0 && this.arena_s0) { this.arena_s0 = false; this.arenaActive = this.arenaActive - 1; }
        if (slotId == 1 && this.arena_s1) { this.arena_s1 = false; this.arenaActive = this.arenaActive - 1; }
        if (slotId == 2 && this.arena_s2) { this.arena_s2 = false; this.arenaActive = this.arenaActive - 1; }
        if (slotId == 3 && this.arena_s3) { this.arena_s3 = false; this.arenaActive = this.arenaActive - 1; }
    },

    function acquireBuffer(): number {
        if (!this.buf_b0) { this.buf_b0 = true; return 0; }
        if (!this.buf_b1) { this.buf_b1 = true; return 1; }
        if (!this.buf_b2) { this.buf_b2 = true; return 2; }
        if (!this.buf_b3) { this.buf_b3 = true; return 3; }
        return -1;
    },

    function releaseBuffer(bufId: number): void {
        if (bufId == 0) { this.buf_b0 = false; }
        if (bufId == 1) { this.buf_b1 = false; }
        if (bufId == 2) { this.buf_b2 = false; }
        if (bufId == 3) { this.buf_b3 = false; }
        this.poolRecycledCount = this.poolRecycledCount + 1;
    },

    function setStrictSlash(strict: boolean): void {
        this.isStrictSlash = strict;
    },

    function onRequest(hook: (req: Request, res: Response) => void): void {
        this.onRequestHook = hook;
        this.hasOnRequestHook = true;
    },

    function use(mwHandler: (req: Request, res: Response) => boolean): void {
        if (this.middlewareCount == 0) { this.mw0_fn = mwHandler; this.mw0_has = true; }
        if (this.middlewareCount == 1) { this.mw1_fn = mwHandler; this.mw1_has = true; }
        if (this.middlewareCount == 2) { this.mw2_fn = mwHandler; this.mw2_has = true; }
        this.middlewareCount = this.middlewareCount + 1;
    },

    function setNotFoundHandler(handler: (req: Request, res: Response) => void): void {
        this.notFoundHandler = handler;
        this.hasNotFoundHandler = true;
    },

    function group(prefix: string, groupCallback: (g: VitoGroup) => void): void {
        let g: VitoGroup;
        g.app = this;
        g.prefix = prefix;
        groupCallback(g);
    },

    function get(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("GET", path, handler);
    },

    function post(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("POST", path, handler);
    },

    function put(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("PUT", path, handler);
    },

    function delete(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("DELETE", path, handler);
    },

    function addRoute(method: string, path: string, handler: (req: Request, res: Response) => void): void {
        if (this.routeCount == 0) { this.r0_method = method; this.r0_path = path; this.r0_fn = handler; this.r0_has = true; }
        if (this.routeCount == 1) { this.r1_method = method; this.r1_path = path; this.r1_fn = handler; this.r1_has = true; }
        if (this.routeCount == 2) { this.r2_method = method; this.r2_path = path; this.r2_has = true; }
        if (this.routeCount == 3) { this.r3_method = method; this.r3_path = path; this.r3_has = true; }
        if (this.routeCount == 4) { this.r4_method = method; this.r4_path = path; this.r4_has = true; }
        if (this.routeCount == 5) { this.r5_method = method; this.r5_path = path; this.r5_has = true; }
        if (this.routeCount == 6) { this.r6_method = method; this.r6_path = path; this.r6_has = true; }
        if (this.routeCount == 7) { this.r7_method = method; this.r7_path = path; this.r7_has = true; }
        this.routeCount = this.routeCount + 1;
    },

    function handleRequest(req: Request, res: Response): void {
        // A. Acquire Memory Arena Slot for zero-alloc execution
        let slotId = this.acquireArenaSlot();

        // B. Trigger Request Lifecycle Hook
        if (this.hasOnRequestHook) {
            let hookFn = this.onRequestHook;
            hookFn(req, res);
            if (res.isClosed) {
                if (slotId >= 0) { this.releaseArenaSlot(slotId); }
                return;
            }
        }

        // C. Run Middleware Pipeline
        if (this.mw0_has) { let mwfn0 = this.mw0_fn; if (!mwfn0(req, res) || res.isClosed) { if (slotId >= 0) { this.releaseArenaSlot(slotId); } return; } }
        if (this.mw1_has) { let mwfn1 = this.mw1_fn; if (!mwfn1(req, res) || res.isClosed) { if (slotId >= 0) { this.releaseArenaSlot(slotId); } return; } }
        if (this.mw2_has) { let mwfn2 = this.mw2_fn; if (!mwfn2(req, res) || res.isClosed) { if (slotId >= 0) { this.releaseArenaSlot(slotId); } return; } }

        // D. Dispatch to Router with Dynamic Path & Trailing Slash Matching
        let matched = false;
        let isStrict = this.isStrictSlash;

        if (this.r0_has && this.r0_method == req.method && matchRoutePattern(this.r0_path, req.path, req, isStrict)) {
            matched = true;
            let rfn0 = this.r0_fn;
            rfn0(req, res);
        } else {
            if (this.r1_has && this.r1_method == req.method && matchRoutePattern(this.r1_path, req.path, req, isStrict)) {
                matched = true;
                let rfn1 = this.r1_fn;
                rfn1(req, res);
            } else {
                if (this.r2_has && this.r2_method == req.method && matchRoutePattern(this.r2_path, req.path, req, isStrict)) {
                    matched = true;
                    let rfn2 = this.r2_fn;
                    rfn2(req, res);
                } else {
                    if (this.r3_has && this.r3_method == req.method && matchRoutePattern(this.r3_path, req.path, req, isStrict)) {
                        matched = true;
                        let rfn3 = this.r3_fn;
                        rfn3(req, res);
                    } else {
                        if (this.r4_has && this.r4_method == req.method && matchRoutePattern(this.r4_path, req.path, req, isStrict)) {
                            matched = true;
                            let rfn4 = this.r4_fn;
                            rfn4(req, res);
                        } else {
                            if (this.r5_has && this.r5_method == req.method && matchRoutePattern(this.r5_path, req.path, req, isStrict)) {
                                matched = true;
                                let rfn5 = this.r5_fn;
                                rfn5(req, res);
                            } else {
                                if (this.r6_has && this.r6_method == req.method && matchRoutePattern(this.r6_path, req.path, req, isStrict)) {
                                    matched = true;
                                    let rfn6 = this.r6_fn;
                                    rfn6(req, res);
                                } else {
                                    if (this.r7_has && this.r7_method == req.method && matchRoutePattern(this.r7_path, req.path, req, isStrict)) {
                                        matched = true;
                                        let rfn7 = this.r7_fn;
                                        rfn7(req, res);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // E. Custom or Default 404 Not Found Handling
        if (!matched && !res.isClosed) {
            if (this.hasNotFoundHandler) {
                let nfFn = this.notFoundHandler;
                nfFn(req, res);
            } else {
                res.setStatus(404).json("{\"error\":\"Route Not Found\",\"path\":\"" + req.path + "\",\"method\":\"" + req.method + "\"}");
            }
        }

        // Release Arena Slot after request processing
        if (slotId >= 0) {
            this.releaseArenaSlot(slotId);
        }
    },

    function inject(method: string, path: string): Response {
        let rawReq = method + " " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n";
        let req = parseHttpRequest(rawReq);
        let res: Response;
        res.status = 200;
        res.statusText = "OK";
        res.headersStr = "";
        res.isClosed = false;
        res.isMock = true;
        res.mockBody = "";
        res.stream.fd = -1;

        this.handleRequest(req, res);
        return res;
    },

    function listen(port: number): void {
        print("=========================================");
        print(" 🚀 Vito Web Framework v1.0.0 (Phase 9 Perf)");
        print(" Running on: http://127.0.0.1:" + port);
        print(" Memory Arena Capacity: " + this.arenaCapacity + " slots");
        print(" Registered Routes: " + this.routeCount);
        print(" Active Middlewares: " + this.middlewareCount);
        print("=========================================");

        let listener = listenTcp("127.0.0.1", port);
        while (true) {
            let bufId = this.acquireBuffer();
            let stream = listener.accept();
            let rawData = stream.read(4096);
            if (rawData.length > 0) {
                let req = parseHttpRequest(rawData);
                let res: Response;
                res.status = 200;
                res.statusText = "OK";
                res.headersStr = "";
                res.stream = stream;
                res.isClosed = false;
                res.isMock = false;
                res.mockBody = "";

                this.handleRequest(req, res);
            } else {
                stream.close();
            }
            if (bufId >= 0) {
                this.releaseBuffer(bufId);
            }
        }
    }
}

function createApp(): VitoApp {
    let app: VitoApp;
    app.init();
    return app;
}

function runVitoApp(port: number): void {
    let app = createApp();
    app.get("/", (req: Request, res: Response) => {
        res.json("{\"status\":\"ok\",\"framework\":\"Vito v1.0.0\",\"engine\":\"VIT Native Phase 9 Perf\"}");
    });
    app.listen(port);
}
