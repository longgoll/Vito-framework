// Vito Web Framework Engine (vito/src/vito.vit)
import { listenTcp, TcpListener, TcpStream } from "std/net";
import { charAt } from "std/string";

// 1. Helper Functions for Path & Header Parsing
function getPathSegment(path: string, segIndex: number): string {
    let len = path.length;
    let i = 0;
    let currentSeg = 0;
    let result = "";
    while (i < len) {
        let ch = charAt(path, i);
        if (ch == "/") {
            if (result.length > 0 || i > 0) {
                if (currentSeg == segIndex) {
                    return result;
                }
                currentSeg = currentSeg + 1;
                result = "";
            }
        } else {
            result = result + ch;
        }
        i = i + 1;
    }
    if (currentSeg == segIndex) {
        return result;
    }
    return "";
}

function getPathSegmentCount(path: string): number {
    let len = path.length;
    let i = 0;
    let count = 0;
    let hasChar = false;
    while (i < len) {
        let ch = charAt(path, i);
        if (ch == "/") {
            if (hasChar) {
                count = count + 1;
                hasChar = false;
            }
        } else {
            hasChar = true;
        }
        i = i + 1;
    }
    if (hasChar) {
        count = count + 1;
    }
    return count;
}

function parseQueryParam(queryString: string, targetKey: string): string {
    if (queryString.length == 0 || targetKey.length == 0) { return ""; }
    let len = queryString.length;
    let i = 0;
    let currentKey = "";
    let currentValue = "";
    let isParsingValue = false;

    while (i < len) {
        let ch = charAt(queryString, i);
        if (ch == "&" || i == len - 1) {
            if (ch != "&") {
                if (isParsingValue) { currentValue = currentValue + ch; }
                else { currentKey = currentKey + ch; }
            }
            if (currentKey == targetKey) {
                return currentValue;
            }
            currentKey = "";
            currentValue = "";
            isParsingValue = false;
        } else if (ch == "=") {
            isParsingValue = true;
        } else {
            if (isParsingValue) { currentValue = currentValue + ch; }
            else { currentKey = currentKey + ch; }
        }
        i = i + 1;
    }
    return "";
}

function parseHeaderParam(rawReq: string, targetHeader: string): string {
    if (rawReq.length == 0 || targetHeader.length == 0) { return ""; }
    let len = rawReq.length;
    let i = 0;
    while (i < len && charAt(rawReq, i) != "\n") {
        i = i + 1;
    }
    i = i + 1;

    let currentLine = "";
    while (i < len) {
        let ch = charAt(rawReq, i);
        if (ch == "\r") {
            if (currentLine.length > 0) {
                let colonPos = -1;
                let c = 0;
                while (c < currentLine.length) {
                    if (charAt(currentLine, c) == ":") {
                        colonPos = c;
                        break;
                    }
                    c = c + 1;
                }
                if (colonPos > 0) {
                    let hName = "";
                    let hVal = "";
                    let k = 0;
                    while (k < colonPos) {
                        hName = hName + charAt(currentLine, k);
                        k = k + 1;
                    }
                    k = colonPos + 1;
                    while (k < currentLine.length && charAt(currentLine, k) == " ") {
                        k = k + 1;
                    }
                    while (k < currentLine.length) {
                        hVal = hVal + charAt(currentLine, k);
                        k = k + 1;
                    }
                    if (hName == targetHeader) {
                        return hVal;
                    }
                }
            }
            currentLine = "";
        } else if (ch != "\n") {
            currentLine = currentLine + ch;
        }
        i = i + 1;
    }
    return "";
}

// 2. Request Context Struct with Helpers
struct Request {
    method: string,
    path: string,
    queryString: string,
    body: string,
    raw: string,
    paramsKeys: string[],
    paramsValues: string[],
    paramsCount: number,

    function param(key: string): string {
        let i = 0;
        while (i < this.paramsCount) {
            if (this.paramsKeys[i] == key) {
                return this.paramsValues[i];
            }
            i = i + 1;
        }
        return "";
    },

    function query(key: string): string {
        return parseQueryParam(this.queryString, key);
    },

    function header(key: string): string {
        return parseHeaderParam(this.raw, key);
    }
}

// 3. Dynamic Path Matching Engine (:id)
function matchRoutePattern(routePath: string, reqPath: string, req: Request): boolean {
    if (routePath == reqPath) {
        return true;
    }

    let routeSegCount = getPathSegmentCount(routePath);
    let reqSegCount = getPathSegmentCount(reqPath);

    if (routeSegCount != reqSegCount) {
        return false;
    }

    let s = 0;
    let matched = true;
    let tempKeys: string[] = ["", "", "", "", ""];
    let tempVals: string[] = ["", "", "", "", ""];
    let tempCount = 0;

    while (s < routeSegCount) {
        let rSeg = getPathSegment(routePath, s);
        let pSeg = getPathSegment(reqPath, s);

        if (rSeg.length > 0 && charAt(rSeg, 0) == ":") {
            let paramKey = "";
            let k = 1;
            while (k < rSeg.length) {
                paramKey = paramKey + charAt(rSeg, k);
                k = k + 1;
            }
            tempKeys[tempCount] = paramKey;
            tempVals[tempCount] = pSeg;
            tempCount = tempCount + 1;
        } else if (rSeg != pSeg) {
            matched = false;
            break;
        }
        s = s + 1;
    }

    if (matched) {
        let c = 0;
        while (c < tempCount) {
            req.paramsKeys[req.paramsCount] = tempKeys[c];
            req.paramsValues[req.paramsCount] = tempVals[c];
            req.paramsCount = req.paramsCount + 1;
            c = c + 1;
        }
        return true;
    }

    return false;
}

// 4. Response Context & HTTP Status Code Handling
struct Response {
    status: number,
    statusText: string,
    headersStr: string,
    stream: TcpStream,
    isClosed: boolean,

    function setHeader(name: string, value: string): void {
        this.headersStr = this.headersStr + name + ": " + value + "\r\n";
    },

    function setStatus(code: number): Response {
        this.status = code;
        if (code == 200) { this.statusText = "OK"; }
        else if (code == 201) { this.statusText = "Created"; }
        else if (code == 204) { this.statusText = "No Content"; }
        else if (code == 400) { this.statusText = "Bad Request"; }
        else if (code == 401) { this.statusText = "Unauthorized"; }
        else if (code == 403) { this.statusText = "Forbidden"; }
        else if (code == 404) { this.statusText = "Not Found"; }
        else if (code == 500) { this.statusText = "Internal Server Error"; }
        else { this.statusText = "OK"; }
        return this;
    },

    function send(text: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: text/plain; charset=utf-8\r\n" +
                        "Content-Length: " + text.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        this.stream.write(headerStr + text);
        this.stream.close();
        this.isClosed = true;
    },

    function html(htmlStr: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: text/html; charset=utf-8\r\n" +
                        "Content-Length: " + htmlStr.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        this.stream.write(headerStr + htmlStr);
        this.stream.close();
        this.isClosed = true;
    },

    function json(jsonStr: string): void {
        if (this.isClosed) { return; }
        if (this.status == 0) { this.setStatus(200); }
        let headerStr = "HTTP/1.1 " + this.status + " " + this.statusText + "\r\n" +
                        "Content-Type: application/json; charset=utf-8\r\n" +
                        "Content-Length: " + jsonStr.length + "\r\n" +
                        this.headersStr +
                        "Connection: close\r\n\r\n";
        this.stream.write(headerStr + jsonStr);
        this.stream.close();
        this.isClosed = true;
    }
}

// 5. HTTP Request Parser
function parseHttpMethod(raw: string): string {
    let method = "";
    let len = raw.length;
    let i = 0;
    while (i < len) {
        let ch = charAt(raw, i);
        if (ch == " ") { break; }
        method = method + ch;
        i = i + 1;
    }
    if (method == "") { return "GET"; }
    return method;
}

function parseHttpPath(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i < len && charAt(raw, i) != " ") { i = i + 1; }
    while (i < len && charAt(raw, i) == " ") { i = i + 1; }
    let path = "";
    while (i < len) {
        let ch = charAt(raw, i);
        if (ch == " " || ch == "?" || ch == "\r" || ch == "\n") { break; }
        path = path + ch;
        i = i + 1;
    }
    if (path == "") { return "/"; }
    return path;
}

function parseQueryString(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i < len && charAt(raw, i) != " ") { i = i + 1; }
    while (i < len && charAt(raw, i) == " ") { i = i + 1; }
    while (i < len && charAt(raw, i) != " " && charAt(raw, i) != "?") { i = i + 1; }
    if (i < len && charAt(raw, i) == "?") {
        i = i + 1;
        let query = "";
        while (i < len) {
            let ch = charAt(raw, i);
            if (ch == " " || ch == "\r" || ch == "\n") { break; }
            query = query + ch;
            i = i + 1;
        }
        return query;
    }
    return "";
}

function parseHttpBody(raw: string): string {
    let len = raw.length;
    let i = 0;
    while (i + 3 < len) {
        if (charAt(raw, i) == "\r" && charAt(raw, i + 1) == "\n" && charAt(raw, i + 2) == "\r" && charAt(raw, i + 3) == "\n") {
            i = i + 4;
            let body = "";
            while (i < len) {
                body = body + charAt(raw, i);
                i = i + 1;
            }
            return body;
        }
        i = i + 1;
    }
    return "";
}

function parseHttpRequest(raw: string): Request {
    let req: Request;
    req.raw = raw;
    req.method = parseHttpMethod(raw);
    req.path = parseHttpPath(raw);
    req.queryString = parseQueryString(raw);
    req.body = parseHttpBody(raw);
    req.paramsKeys = ["", "", "", "", ""];
    req.paramsValues = ["", "", "", "", ""];
    req.paramsCount = 0;
    return req;
}

// 6. Router, Grouping & Custom Error Handler Pipeline Architecture
struct RouteEntry {
    method: string,
    path: string,
    handler: (req: Request, res: Response) => void
}

struct MiddlewareEntry {
    handler: (req: Request, res: Response) => boolean
}

struct VitoGroup {
    app: VitoApp,
    prefix: string,

    function get(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("GET", this.prefix + path, handler);
    },

    function post(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("POST", this.prefix + path, handler);
    },

    function put(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("PUT", this.prefix + path, handler);
    },

    function delete(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("DELETE", this.prefix + path, handler);
    }
}

struct VitoApp {
    routes: RouteEntry[],
    routeCount: number,
    middlewares: MiddlewareEntry[],
    middlewareCount: number,
    notFoundHandler: (req: Request, res: Response) => void,
    hasNotFoundHandler: boolean,

    function init(): void {
        this.routeCount = 0;
        this.middlewareCount = 0;
        this.hasNotFoundHandler = false;
    },

    function use(mwHandler: (req: Request, res: Response) => boolean): void {
        let mw: MiddlewareEntry;
        mw.handler = mwHandler;
        this.middlewares[this.middlewareCount] = mw;
        this.middlewareCount = this.middlewareCount + 1;
    },

    function setNotFoundHandler(handler: (req: Request, res: Response) => void): void {
        this.notFoundHandler = handler;
        this.hasNotFoundHandler = true;
    },

    function group(prefix: string, groupCallback: (g: VitoGroup) => void): void {
        let g: VitoGroup;
        g.app = this;
        g.prefix = prefix;
        groupCallback(g);
    },

    function get(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("GET", path, handler);
    },

    function post(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("POST", path, handler);
    },

    function put(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("PUT", path, handler);
    },

    function delete(path: string, handler: (req: Request, res: Response) => void): void {
        this.addRoute("DELETE", path, handler);
    },

    function addRoute(method: string, path: string, handler: (req: Request, res: Response) => void): void {
        let r: RouteEntry;
        r.method = method;
        r.path = path;
        r.handler = handler;
        this.routes[this.routeCount] = r;
        this.routeCount = this.routeCount + 1;
    },

    function handleRequest(req: Request, res: Response): void {
        // A. Run Middleware Pipeline
        let m = 0;
        while (m < this.middlewareCount) {
            let mw = this.middlewares[m];
            let next = mw.handler(req, res);
            if (!next || res.isClosed) {
                return;
            }
            m = m + 1;
        }

        // B. Dispatch to Router with Dynamic Path Matching (:id)
        let i = 0;
        let matched = false;
        while (i < this.routeCount) {
            let r = this.routes[i];
            if (r.method == req.method && matchRoutePattern(r.path, req.path, req)) {
                matched = true;
                r.handler(req, res);
                break;
            }
            i = i + 1;
        }

        // C. Custom or Default 404 Not Found Handling
        if (!matched && !res.isClosed) {
            if (this.hasNotFoundHandler) {
                this.notFoundHandler(req, res);
            } else {
                res.setStatus(404).json("{\"error\":\"Route Not Found\",\"path\":\"" + req.path + "\",\"method\":\"" + req.method + "\"}");
            }
        }
    },

    function listen(port: number): void {
        print("=========================================");
        print(" 🚀 Vito Web Framework v1.0.0 (VIT Native)");
        print(" Running on: http://127.0.0.1:" + port);
        print(" Registered Routes: " + this.routeCount);
        print(" Active Middlewares: " + this.middlewareCount);
        print("=========================================");

        let listener = listenTcp("127.0.0.1", port);
        while (true) {
            let stream = listener.accept();
            let rawData = stream.read(4096);
            if (rawData.length > 0) {
                let req = parseHttpRequest(rawData);
                let res: Response;
                res.status = 200;
                res.statusText = "OK";
                res.headersStr = "";
                res.stream = stream;
                res.isClosed = false;

                this.handleRequest(req, res);
            } else {
                stream.close();
            }
        }
    }
}

function createApp(): VitoApp {
    let app: VitoApp;
    app.init();
    return app;
}

function runVitoApp(port: number): void {
    let app = createApp();
    app.get("/", (req: Request, res: Response) => {
        res.json("{\"status\":\"ok\",\"framework\":\"Vito v1.0.0\",\"engine\":\"VIT Native\"}");
    });
    app.listen(port);
}
