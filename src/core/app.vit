    // ── Request Dispatch — 3-Pass Route Precedence Engine ────────────────
    function handleRequest(req: Request, res: Response): void {
        let slotId = this.acquireArenaSlot();

        // A. onRequest lifecycle hook
        if (this.hasOnRequestHook) {
            let hookFn = this.onRequestHook;
            hookFn(req, res);
            if (res.isClosed > 0.0) { if (slotId >= 0.0) { this.releaseArenaSlot(slotId); } return; }
        }

        // B. Global Middleware Pipeline (8 slots)
        if (this.mw0_has > 0.0) { let mwFn0=this.mw0_fn; if (!mwFn0(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw1_has > 0.0) { let mwFn1=this.mw1_fn; if (!mwFn1(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw2_has > 0.0) { let mwFn2=this.mw2_fn; if (!mwFn2(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw3_has > 0.0) { let mwFn3=this.mw3_fn; if (!mwFn3(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw4_has > 0.0) { let mwFn4=this.mw4_fn; if (!mwFn4(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw5_has > 0.0) { let mwFn5=this.mw5_fn; if (!mwFn5(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw6_has > 0.0) { let mwFn6=this.mw6_fn; if (!mwFn6(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }
        if (this.mw7_has > 0.0) { let mwFn7=this.mw7_fn; if (!mwFn7(req,res)||res.isClosed > 0.0) { if(slotId>=0.0){this.releaseArenaSlot(slotId);} return; } }

