// Vito Application Core Engine (vito/src/core/app.vit)
import { listenTcp, TcpListener, TcpStream } from "std/net";
import { charAt } from "std/string";
extern function vit_net_socket_is_connected(fd: number): number;
import { Request, parseHttpRequest } from "src/core/request.vit";
import { Response } from "src/core/response.vit";
import { matchRoutePattern, pathMatchesPattern } from "src/core/matcher.vit";
import { getRouteType } from "src/core/utils.vit";

// RI-02: Expose C runtime multi-worker epoll group for TFB multi-core scaling
// vit_iouring_group_create/start accept a low-level C handler, so listenMultiWorker
// bridges the .vit high-level API to the epoll worker pool.
extern function vit_sysconf_nprocs(): number;  // wraps sysconf(_SC_NPROCESSORS_ONLN)

// ═══════════════════════════════════════════════════════════════════════════
// Router, Grouping & Vito Application Core
// ═══════════════════════════════════════════════════════════════════════════

// VitoGroup — Route group with shared prefix (supports GET/POST/PUT/PATCH/DELETE/HEAD/OPTIONS/ANY)
struct VitoGroup {
    app: VitoApp,
    prefix: string,

    function get(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("GET", this.prefix + path, handler);
    },
    function post(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("POST", this.prefix + path, handler);
    },
    function put(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("PUT", this.prefix + path, handler);
    },
    function delete(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("DELETE", this.prefix + path, handler);
    },
    function patch(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("PATCH", this.prefix + path, handler);
    },
    function head(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("HEAD", this.prefix + path, handler);
    },
    function options(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("OPTIONS", this.prefix + path, handler);
    },
    function any(path: string, handler: (req: Request, res: Response) => void): void {
        this.app.addRoute("ANY", this.prefix + path, handler);
    }
}

// VitoApp — Main application struct (32 route slots, 8 middleware slots, 16 named routes)
struct VitoApp {
    // ── Route slots 0-7 ──────────────────────────────────────────────────
    r0_method: string,  r0_path: string,  r0_type: number,  r0_fn: (req: Request, res: Response) => void,  r0_has: number,
    r1_method: string,  r1_path: string,  r1_type: number,  r1_fn: (req: Request, res: Response) => void,  r1_has: number,
    r2_method: string,  r2_path: string,  r2_type: number,  r2_fn: (req: Request, res: Response) => void,  r2_has: number,
    r3_method: string,  r3_path: string,  r3_type: number,  r3_fn: (req: Request, res: Response) => void,  r3_has: number,
    r4_method: string,  r4_path: string,  r4_type: number,  r4_fn: (req: Request, res: Response) => void,  r4_has: number,
    r5_method: string,  r5_path: string,  r5_type: number,  r5_fn: (req: Request, res: Response) => void,  r5_has: number,
    r6_method: string,  r6_path: string,  r6_type: number,  r6_fn: (req: Request, res: Response) => void,  r6_has: number,
    r7_method: string,  r7_path: string,  r7_type: number,  r7_fn: (req: Request, res: Response) => void,  r7_has: number,
    // ── Route slots 8-15 ─────────────────────────────────────────────────
    r8_method: string,  r8_path: string,  r8_type: number,  r8_fn: (req: Request, res: Response) => void,  r8_has: number,
    r9_method: string,  r9_path: string,  r9_type: number,  r9_fn: (req: Request, res: Response) => void,  r9_has: number,
    r10_method: string, r10_path: string, r10_type: number, r10_fn: (req: Request, res: Response) => void, r10_has: number,
    r11_method: string, r11_path: string, r11_type: number, r11_fn: (req: Request, res: Response) => void, r11_has: number,
    r12_method: string, r12_path: string, r12_type: number, r12_fn: (req: Request, res: Response) => void, r12_has: number,
    r13_method: string, r13_path: string, r13_type: number, r13_fn: (req: Request, res: Response) => void, r13_has: number,
    r14_method: string, r14_path: string, r14_type: number, r14_fn: (req: Request, res: Response) => void, r14_has: number,
    r15_method: string, r15_path: string, r15_type: number, r15_fn: (req: Request, res: Response) => void, r15_has: number,
    // ── Route slots 16-23 ────────────────────────────────────────────────
    r16_method: string, r16_path: string, r16_type: number, r16_fn: (req: Request, res: Response) => void, r16_has: number,
    r17_method: string, r17_path: string, r17_type: number, r17_fn: (req: Request, res: Response) => void, r17_has: number,
    r18_method: string, r18_path: string, r18_type: number, r18_fn: (req: Request, res: Response) => void, r18_has: number,
    r19_method: string, r19_path: string, r19_type: number, r19_fn: (req: Request, res: Response) => void, r19_has: number,
    r20_method: string, r20_path: string, r20_type: number, r20_fn: (req: Request, res: Response) => void, r20_has: number,
    r21_method: string, r21_path: string, r21_type: number, r21_fn: (req: Request, res: Response) => void, r21_has: number,
    r22_method: string, r22_path: string, r22_type: number, r22_fn: (req: Request, res: Response) => void, r22_has: number,
    r23_method: string, r23_path: string, r23_type: number, r23_fn: (req: Request, res: Response) => void, r23_has: number,
    // ── Route slots 24-31 ────────────────────────────────────────────────
    r24_method: string, r24_path: string, r24_type: number, r24_fn: (req: Request, res: Response) => void, r24_has: number,
    r25_method: string, r25_path: string, r25_type: number, r25_fn: (req: Request, res: Response) => void, r25_has: number,
    r26_method: string, r26_path: string, r26_type: number, r26_fn: (req: Request, res: Response) => void, r26_has: number,
    r27_method: string, r27_path: string, r27_type: number, r27_fn: (req: Request, res: Response) => void, r27_has: number,
    r28_method: string, r28_path: string, r28_type: number, r28_fn: (req: Request, res: Response) => void, r28_has: number,
    r29_method: string, r29_path: string, r29_type: number, r29_fn: (req: Request, res: Response) => void, r29_has: number,
    r30_method: string, r30_path: string, r30_type: number, r30_fn: (req: Request, res: Response) => void, r30_has: number,
    r31_method: string, r31_path: string, r31_type: number, r31_fn: (req: Request, res: Response) => void, r31_has: number,
    // ── Middleware slots 0-7 ──────────────────────────────────────────────
    mw0_has: number, mw0_fn: (req: Request, res: Response) => boolean,
    mw1_has: number, mw1_fn: (req: Request, res: Response) => boolean,
    mw2_has: number, mw2_fn: (req: Request, res: Response) => boolean,
    mw3_has: number, mw3_fn: (req: Request, res: Response) => boolean,
    mw4_has: number, mw4_fn: (req: Request, res: Response) => boolean,
    mw5_has: number, mw5_fn: (req: Request, res: Response) => boolean,
    mw6_has: number, mw6_fn: (req: Request, res: Response) => boolean,
    mw7_has: number, mw7_fn: (req: Request, res: Response) => boolean, 
    // ── Counters ──────────────────────────────────────────────────────────
    routeCount: number,
    middlewareCount: number,
    // ── Lifecycle hooks & error handlers ─────────────────────────────────
    notFoundHandler:           (req: Request, res: Response) => void,
    hasNotFoundHandler:        boolean,
    methodNotAllowedHandler:   (req: Request, res: Response) => void,
    hasMethodNotAllowedHandler: boolean,
    errorHandler:              (req: Request, res: Response) => void,
    hasErrorHandler:           boolean,
    onRequestHook:             (req: Request, res: Response) => void,
    hasOnRequestHook:          boolean,
    beforeHandleHook:          (req: Request, res: Response) => boolean,
    hasBeforeHandleHook:       boolean,
    afterHandleHook:           (req: Request, res: Response) => void,
    hasAfterHandleHook:        boolean,
    onErrorHook:               (req: Request, res: Response) => void,
    hasOnErrorHook:            boolean,
    // ── Named Route Registry (16 slots: name → path template) ────────────
    nr0_name:  string, nr0_rpath:  string, nr0_has:  boolean,
    nr1_name:  string, nr1_rpath:  string, nr1_has:  boolean,
    nr2_name:  string, nr2_rpath:  string, nr2_has:  boolean,
    nr3_name:  string, nr3_rpath:  string, nr3_has:  boolean,
    nr4_name:  string, nr4_rpath:  string, nr4_has:  boolean,
    nr5_name:  string, nr5_rpath:  string, nr5_has:  boolean,
    nr6_name:  string, nr6_rpath:  string, nr6_has:  boolean,
    nr7_name:  string, nr7_rpath:  string, nr7_has:  boolean,
    nr8_name:  string, nr8_rpath:  string, nr8_has:  boolean,
    nr9_name:  string, nr9_rpath:  string, nr9_has:  boolean,
    nr10_name: string, nr10_rpath: string, nr10_has: boolean,
    nr11_name: string, nr11_rpath: string, nr11_has: boolean,
    nr12_name: string, nr12_rpath: string, nr12_has: boolean,
    nr13_name: string, nr13_rpath: string, nr13_has: boolean,
    nr14_name: string, nr14_rpath: string, nr14_has: boolean,
    nr15_name: string, nr15_rpath: string, nr15_has: boolean,
    nrCount: number,
    // ── Config & Arena ────────────────────────────────────────────────────
    isStrictSlash: boolean,
    arenaCapacity: number,
    arenaActive: number,
    arena_s0: boolean, arena_s1: boolean, arena_s2: boolean, arena_s3: boolean,
    poolRecycledCount: number,
    buf_b0: boolean, buf_b1: boolean, buf_b2: boolean, buf_b3: boolean,

    function init(): void {
        this.routeCount = 0.0;
        this.middlewareCount = 0.0;
        this.hasNotFoundHandler        = false;
        this.hasMethodNotAllowedHandler = false;
        this.hasErrorHandler           = false;
        this.hasOnRequestHook          = false;
        this.hasBeforeHandleHook       = false;
        this.hasAfterHandleHook        = false;
        this.hasOnErrorHook            = false;
        this.isStrictSlash             = false;
        // Route slots — has flags & types
        this.r0_has = 0.0; this.r0_type  = 0.0; this.r0_method  = ""; this.r0_path  = "";
        this.r1_has = 0.0; this.r1_type  = 0.0; this.r1_method  = ""; this.r1_path  = "";
        this.r2_has = 0.0; this.r2_type  = 0.0; this.r2_method  = ""; this.r2_path  = "";
        this.r3_has = 0.0; this.r3_type  = 0.0; this.r3_method  = ""; this.r3_path  = "";
        this.r4_has = 0.0; this.r4_type  = 0.0; this.r4_method  = ""; this.r4_path  = "";
        this.r5_has = 0.0; this.r5_type  = 0.0; this.r5_method  = ""; this.r5_path  = "";
        this.r6_has = 0.0; this.r6_type  = 0.0; this.r6_method  = ""; this.r6_path  = "";
        this.r7_has = 0.0; this.r7_type  = 0.0; this.r7_method  = ""; this.r7_path  = "";
        this.r8_has = 0.0; this.r8_type  = 0.0; this.r8_method  = ""; this.r8_path  = "";
        this.r9_has = 0.0; this.r9_type  = 0.0; this.r9_method  = ""; this.r9_path  = "";
        this.r10_has = 0.0; this.r10_type = 0.0; this.r10_method = ""; this.r10_path = "";
        this.r11_has = 0.0; this.r11_type = 0.0; this.r11_method = ""; this.r11_path = "";
        this.r12_has = 0.0; this.r12_type = 0.0; this.r12_method = ""; this.r12_path = "";
        this.r13_has = 0.0; this.r13_type = 0.0; this.r13_method = ""; this.r13_path = "";
        this.r14_has = 0.0; this.r14_type = 0.0; this.r14_method = ""; this.r14_path = "";
        this.r15_has = 0.0; this.r15_type = 0.0; this.r15_method = ""; this.r15_path = "";
        this.r16_has = 0.0; this.r16_type = 0.0; this.r16_method = ""; this.r16_path = "";
        this.r17_has = 0.0; this.r17_type = 0.0; this.r17_method = ""; this.r17_path = "";
        this.r18_has = 0.0; this.r18_type = 0.0; this.r18_method = ""; this.r18_path = "";
        this.r19_has = 0.0; this.r19_type = 0.0; this.r19_method = ""; this.r19_path = "";
        this.r20_has = 0.0; this.r20_type = 0.0; this.r20_method = ""; this.r20_path = "";
        this.r21_has = 0.0; this.r21_type = 0.0; this.r21_method = ""; this.r21_path = "";
        this.r22_has = 0.0; this.r22_type = 0.0; this.r22_method = ""; this.r22_path = "";
        this.r23_has = 0.0; this.r23_type = 0.0; this.r23_method = ""; this.r23_path = "";
        this.r24_has = 0.0; this.r24_type = 0.0; this.r24_method = ""; this.r24_path = "";
        this.r25_has = 0.0; this.r25_type = 0.0; this.r25_method = ""; this.r25_path = "";
        this.r26_has = 0.0; this.r26_type = 0.0; this.r26_method = ""; this.r26_path = "";
        this.r27_has = 0.0; this.r27_type = 0.0; this.r27_method = ""; this.r27_path = "";
        this.r28_has = 0.0; this.r28_type = 0.0; this.r28_method = ""; this.r28_path = "";
        this.r29_has = 0.0; this.r29_type = 0.0; this.r29_method = ""; this.r29_path = "";
        this.r30_has = 0.0; this.r30_type = 0.0; this.r30_method = ""; this.r30_path = "";
        this.r31_has = 0.0; this.r31_type = 0.0; this.r31_method = ""; this.r31_path = "";
        // Middleware slots
        this.mw0_has = 0.0; this.mw1_has = 0.0; this.mw2_has = 0.0; this.mw3_has = 0.0;
        this.mw4_has = 0.0; this.mw5_has = 0.0; this.mw6_has = 0.0; this.mw7_has = 0.0;
        // Named route registry
        this.nrCount = 0.0;
        this.nr0_has  = false; this.nr0_name  = ""; this.nr0_rpath  = "";
        this.nr1_has  = false; this.nr1_name  = ""; this.nr1_rpath  = "";
        this.nr2_has  = false; this.nr2_name  = ""; this.nr2_rpath  = "";
        this.nr3_has  = false; this.nr3_name  = ""; this.nr3_rpath  = "";
        this.nr4_has  = false; this.nr4_name  = ""; this.nr4_rpath  = "";
        this.nr5_has  = false; this.nr5_name  = ""; this.nr5_rpath  = "";
        this.nr6_has  = false; this.nr6_name  = ""; this.nr6_rpath  = "";
        this.nr7_has  = false; this.nr7_name  = ""; this.nr7_rpath  = "";
        this.nr8_has  = false; this.nr8_name  = ""; this.nr8_rpath  = "";
        this.nr9_has  = false; this.nr9_name  = ""; this.nr9_rpath  = "";
        this.nr10_has = false; this.nr10_name = ""; this.nr10_rpath = "";
        this.nr11_has = false; this.nr11_name = ""; this.nr11_rpath = "";
        this.nr12_has = false; this.nr12_name = ""; this.nr12_rpath = "";
        this.nr13_has = false; this.nr13_name = ""; this.nr13_rpath = "";
        this.nr14_has = false; this.nr14_name = ""; this.nr14_rpath = "";
        this.nr15_has = false; this.nr15_name = ""; this.nr15_rpath = "";
        // Arena & buffer pool
        this.arenaCapacity = 4.0; this.arenaActive = 0.0;
        this.arena_s0 = false; this.arena_s1 = false; this.arena_s2 = false; this.arena_s3 = false;
        this.poolRecycledCount = 0.0;
        this.buf_b0 = false; this.buf_b1 = false; this.buf_b2 = false; this.buf_b3 = false;
    },

    function acquireArenaSlot(): number {
        if (!this.arena_s0) { this.arena_s0 = true; this.arenaActive = this.arenaActive + 1.0; return 0.0; }
        if (!this.arena_s1) { this.arena_s1 = true; this.arenaActive = this.arenaActive + 1.0; return 1.0; }
        if (!this.arena_s2) { this.arena_s2 = true; this.arenaActive = this.arenaActive + 1.0; return 2.0; }
        if (!this.arena_s3) { this.arena_s3 = true; this.arenaActive = this.arenaActive + 1.0; return 3.0; }
        return -1.0;
    },

    function releaseArenaSlot(slotId: number): void {
        if (slotId == 0.0 && this.arena_s0) { this.arena_s0 = false; this.arenaActive = this.arenaActive - 1.0; }
        if (slotId == 1.0 && this.arena_s1) { this.arena_s1 = false; this.arenaActive = this.arenaActive - 1.0; }
        if (slotId == 2.0 && this.arena_s2) { this.arena_s2 = false; this.arenaActive = this.arenaActive - 1.0; }
        if (slotId == 3.0 && this.arena_s3) { this.arena_s3 = false; this.arenaActive = this.arenaActive - 1.0; }
    },

    function acquireBuffer(): number {
        if (!this.buf_b0) { this.buf_b0 = true; return 0.0; }
        if (!this.buf_b1) { this.buf_b1 = true; return 1.0; }
        if (!this.buf_b2) { this.buf_b2 = true; return 2.0; }
        if (!this.buf_b3) { this.buf_b3 = true; return 3.0; }
        return -1.0;
    },

    function releaseBuffer(bufId: number): void {
        if (bufId == 0.0) { this.buf_b0 = false; }
        if (bufId == 1.0) { this.buf_b1 = false; }
        if (bufId == 2.0) { this.buf_b2 = false; }
        if (bufId == 3.0) { this.buf_b3 = false; }
        this.poolRecycledCount = this.poolRecycledCount + 1.0;
    },

    function setStrictSlash(strict: boolean): void { this.isStrictSlash = strict; },

    // ── Lifecycle Hooks ───────────────────────────────────────────────────
    function onRequest(hook: (req: Request, res: Response) => void): void {
        this.onRequestHook = hook; this.hasOnRequestHook = true;
    },
    function beforeHandle(hook: (req: Request, res: Response) => boolean): void {
        this.beforeHandleHook = hook; this.hasBeforeHandleHook = true;
    },
    function afterHandle(hook: (req: Request, res: Response) => void): void {
        this.afterHandleHook = hook; this.hasAfterHandleHook = true;
    },
    function onError(hook: (req: Request, res: Response) => void): void {
        this.onErrorHook = hook; this.hasOnErrorHook = true;
    },

    // ── Error Handler Registration ────────────────────────────────────────
    function setNotFoundHandler(handler: (req: Request, res: Response) => void): void {
        this.notFoundHandler = handler; this.hasNotFoundHandler = true;
    },
    function setMethodNotAllowedHandler(handler: (req: Request, res: Response) => void): void {
        this.methodNotAllowedHandler = handler; this.hasMethodNotAllowedHandler = true;
    },
    function setErrorHandler(handler: (req: Request, res: Response) => void): void {
        this.errorHandler = handler; this.hasErrorHandler = true;
    },

    // ── Middleware Registration ───────────────────────────────────────────
    function use(mwHandler: (req: Request, res: Response) => boolean): void {
        if (this.middlewareCount == 0.0) { this.mw0_fn = mwHandler; this.mw0_has = 1.0; }
        if (this.middlewareCount == 1.0) { this.mw1_fn = mwHandler; this.mw1_has = 1.0; }
        if (this.middlewareCount == 2.0) { this.mw2_fn = mwHandler; this.mw2_has = 1.0; }
        if (this.middlewareCount == 3.0) { this.mw3_fn = mwHandler; this.mw3_has = 1.0; }
        if (this.middlewareCount == 4.0) { this.mw4_fn = mwHandler; this.mw4_has = 1.0; }
        if (this.middlewareCount == 5.0) { this.mw5_fn = mwHandler; this.mw5_has = 1.0; }
        if (this.middlewareCount == 6.0) { this.mw6_fn = mwHandler; this.mw6_has = 1.0; }
        if (this.middlewareCount == 7.0) { this.mw7_fn = mwHandler; this.mw7_has = 1.0; }
        this.middlewareCount = this.middlewareCount + 1.0;
    },

    // ── Route Grouping ────────────────────────────────────────────────────
    function group(prefix: string, groupCallback: (g: VitoGroup) => void): void {
        let g: VitoGroup;
        g.app = this;
        g.prefix = prefix;
        groupCallback(g);
    },

    // ── Named Route Registry ──────────────────────────────────────────────
    function nameRoute(routeName: string, routePath: string): void {
        if (this.nrCount == 0.0)  { this.nr0_name  = routeName; this.nr0_rpath  = routePath; this.nr0_has  = true; }
        if (this.nrCount == 1.0)  { this.nr1_name  = routeName; this.nr1_rpath  = routePath; this.nr1_has  = true; }
        if (this.nrCount == 2.0)  { this.nr2_name  = routeName; this.nr2_rpath  = routePath; this.nr2_has  = true; }
        if (this.nrCount == 3.0)  { this.nr3_name  = routeName; this.nr3_rpath  = routePath; this.nr3_has  = true; }
        if (this.nrCount == 4.0)  { this.nr4_name  = routeName; this.nr4_rpath  = routePath; this.nr4_has  = true; }
        if (this.nrCount == 5.0)  { this.nr5_name  = routeName; this.nr5_rpath  = routePath; this.nr5_has  = true; }
        if (this.nrCount == 6.0)  { this.nr6_name  = routeName; this.nr6_rpath  = routePath; this.nr6_has  = true; }
        if (this.nrCount == 7.0)  { this.nr7_name  = routeName; this.nr7_rpath  = routePath; this.nr7_has  = true; }
        if (this.nrCount == 8.0)  { this.nr8_name  = routeName; this.nr8_rpath  = routePath; this.nr8_has  = true; }
        if (this.nrCount == 9.0)  { this.nr9_name  = routeName; this.nr9_rpath  = routePath; this.nr9_has  = true; }
        if (this.nrCount == 10.0) { this.nr10_name = routeName; this.nr10_rpath = routePath; this.nr10_has = true; }
        if (this.nrCount == 11.0) { this.nr11_name = routeName; this.nr11_rpath = routePath; this.nr11_has = true; }
        if (this.nrCount == 12.0) { this.nr12_name = routeName; this.nr12_rpath = routePath; this.nr12_has = true; }
        if (this.nrCount == 13.0) { this.nr13_name = routeName; this.nr13_rpath = routePath; this.nr13_has = true; }
        if (this.nrCount == 14.0) { this.nr14_name = routeName; this.nr14_rpath = routePath; this.nr14_has = true; }
        if (this.nrCount == 15.0) { this.nr15_name = routeName; this.nr15_rpath = routePath; this.nr15_has = true; }
        this.nrCount = this.nrCount + 1.0;
    },

    function url(name: string, paramKey: string, paramVal: string): string {
        let path = "";
        if (this.nr0_has  && this.nr0_name  == name) { path = this.nr0_rpath;  }
        if (path == "" && this.nr1_has  && this.nr1_name  == name) { path = this.nr1_rpath;  }
        if (path == "" && this.nr2_has  && this.nr2_name  == name) { path = this.nr2_rpath;  }
        if (path == "" && this.nr3_has  && this.nr3_name  == name) { path = this.nr3_rpath;  }
        if (path == "" && this.nr4_has  && this.nr4_name  == name) { path = this.nr4_rpath;  }
        if (path == "" && this.nr5_has  && this.nr5_name  == name) { path = this.nr5_rpath;  }
        if (path == "" && this.nr6_has  && this.nr6_name  == name) { path = this.nr6_rpath;  }
        if (path == "" && this.nr7_has  && this.nr7_name  == name) { path = this.nr7_rpath;  }
        if (path == "" && this.nr8_has  && this.nr8_name  == name) { path = this.nr8_rpath;  }
        if (path == "" && this.nr9_has  && this.nr9_name  == name) { path = this.nr9_rpath;  }
        if (path == "" && this.nr10_has && this.nr10_name == name) { path = this.nr10_rpath; }
        if (path == "" && this.nr11_has && this.nr11_name == name) { path = this.nr11_rpath; }
        if (path == "" && this.nr12_has && this.nr12_name == name) { path = this.nr12_rpath; }
        if (path == "" && this.nr13_has && this.nr13_name == name) { path = this.nr13_rpath; }
        if (path == "" && this.nr14_has && this.nr14_name == name) { path = this.nr14_rpath; }
        if (path == "" && this.nr15_has && this.nr15_name == name) { path = this.nr15_rpath; }
        if (path == "") { return ""; }

        let result = "";
        let len = path.length;
        let i = 0;
        let replaced = false;
        while (i < len) {
            let ch = charAt(path, i);
            if (ch == ":" && !replaced) {
                i = i + 1;
                let segName = "";
                while (i < len) {
                    let c = charAt(path, i);
                    if (c == "/" || c == "?") { break; }
                    segName = segName + c;
                    i = i + 1;
                }
                if (i < len && charAt(path, i) == "?") { i = i + 1; }
                if (segName == paramKey) { result = result + paramVal; replaced = true; }
                else { result = result + ":" + segName; }
            } else {
                result = result + ch;
                i = i + 1;
            }
        }
        return result;
    },

