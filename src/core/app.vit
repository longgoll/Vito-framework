        if (!matched && this.r0_has > 0.0)  { if (this.r0_type  == 0.0 && (this.r0_method  == req.method || this.r0_method  == "ANY") && matchRoutePattern(this.r0_path,  req.path, req, isStrict)) { matched = true; let fn_r0_p0 = this.r0_fn; fn_r0_p0(req,res); } }
        if (!matched && this.r1_has > 0.0)  { if (this.r1_type  == 0.0 && (this.r1_method  == req.method || this.r1_method  == "ANY") && matchRoutePattern(this.r1_path,  req.path, req, isStrict)) { matched = true; let fn_r1_p0 = this.r1_fn; fn_r1_p0(req,res); } }
