            if (!pathExists && this.r13_has > 0.0) { if (pathMatchesPattern(this.r13_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r14_has > 0.0) { if (pathMatchesPattern(this.r14_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r15_has > 0.0) { if (pathMatchesPattern(this.r15_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r16_has > 0.0) { if (pathMatchesPattern(this.r16_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r17_has > 0.0) { if (pathMatchesPattern(this.r17_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r18_has > 0.0) { if (pathMatchesPattern(this.r18_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r19_has > 0.0) { if (pathMatchesPattern(this.r19_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r20_has > 0.0) { if (pathMatchesPattern(this.r20_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r21_has > 0.0) { if (pathMatchesPattern(this.r21_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r22_has > 0.0) { if (pathMatchesPattern(this.r22_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r23_has > 0.0) { if (pathMatchesPattern(this.r23_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r24_has > 0.0) { if (pathMatchesPattern(this.r24_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r25_has > 0.0) { if (pathMatchesPattern(this.r25_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r26_has > 0.0) { if (pathMatchesPattern(this.r26_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r27_has > 0.0) { if (pathMatchesPattern(this.r27_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r28_has > 0.0) { if (pathMatchesPattern(this.r28_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r29_has > 0.0) { if (pathMatchesPattern(this.r29_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r30_has > 0.0) { if (pathMatchesPattern(this.r30_path, req.path, isStrict)) { pathExists = true; } }
            if (!pathExists && this.r31_has > 0.0) { if (pathMatchesPattern(this.r31_path, req.path, isStrict)) { pathExists = true; } }

            if (pathExists) {
                // 405 Method Not Allowed — path exists, method rejected
                if (this.hasMethodNotAllowedHandler) {
                    let mnaFn = this.methodNotAllowedHandler;
                    mnaFn(req, res);
                } else {
                    res.setStatus(405.0).json("{\"error\":\"Method Not Allowed\",\"method\":\"" + req.method + "\",\"path\":\"" + req.path + "\"}");
                }
            } else {
                // 404 Not Found
                if (this.hasOnErrorHook) {
                    res.setStatus(404.0);
                    let errFn = this.onErrorHook;
                    errFn(req, res);
                } else {
                    if (this.hasErrorHandler) {
                        res.setStatus(404.0);
                        let efn = this.errorHandler;
                        efn(req, res);
                    } else {
                        if (this.hasNotFoundHandler) {
                            let nfFn = this.notFoundHandler;
                            nfFn(req, res);
                        } else {
                            res.setStatus(404.0).json("{\"error\":\"Route Not Found\",\"path\":\"" + req.path + "\",\"method\":\"" + req.method + "\"}");
                        }
                    }
                }
            }
        }

        if (slotId >= 0.0) { this.releaseArenaSlot(slotId); }
    },

    function inject(method: string, path: string): Response {
        let rawReq = method + " " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n";
        let req = parseHttpRequest(rawReq);
        let res: Response;
        res.initMock();
        this.handleRequest(req, res);
        return res;
    },

    function injectBody(method: string, path: string): string {
        let rawReq = method + " " + path + " HTTP/1.1\r\nHost: localhost\r\n\r\n";
        let req = parseHttpRequest(rawReq);
        let res: Response;
        res.initMock();
        this.handleRequest(req, res);
        return res.mockBody;
    },

    function listen(port: number): void {
        print("=========================================");
        print(" ⚡ Vito Web Framework v1.2.0");
        print(" Running on: http://0.0.0.0:" + port);
        let strictStr = "false";
        if (this.isStrictSlash) { strictStr = "true"; }
        print(" Memory Arena: " + this.arenaCapacity + " slots | Strict Slash: " + strictStr);
        print(" Routes: " + this.routeCount + "/32 | Middleware: " + this.middlewareCount + "/8");
        print(" Named Routes: " + this.nrCount + "/16 | HTTP Methods: GET POST PUT PATCH DELETE HEAD OPTIONS ANY");
        print(" Features: Route Precedence ✓ | Optional Params ✓ | Wildcard Multi-seg ✓ | 405 Handler ✓");
        print("=========================================");

        let listener = listenTcp("0.0.0.0", port);  // RI-01: must bind all interfaces for TFB Docker networking
        while (true) {
            let stream = listener.accept();
            let keepAlive = true;
            while (keepAlive) {
                let bufId = this.acquireBuffer();
                let rawData = stream.read(4096);
                if (rawData.length > 0) {
                    let req = parseHttpRequest(rawData);
                    let res: Response;
                    res.status = 200.0;
                    res.statusText = "OK";
                    res.headersStr = "";
                    res.stream = stream;
                    res.isClosed = 0.0;
                    res.isMock = 0.0;
                    res.mockBody = "";
                    this.handleRequest(req, res);
                    let connHeader = req.header("Connection");
                    if (connHeader == "close" || connHeader == "Close") { keepAlive = false; }
                    if (res.isClosed > 0.0 && vit_net_socket_is_connected(stream.fd) <= 0.0) { keepAlive = false; }
                } else {
                    keepAlive = false;
                }
                if (bufId >= 0) { this.releaseBuffer(bufId); }
            }
            stream.close();
        }
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// Factory Functions
// ═══════════════════════════════════════════════════════════════════════════

// Standard app (Lax trailing slash — /users/ normalized to /users)
function createApp(): VitoApp {
    let app: VitoApp;
    app.init();
    return app;
}

// Strict trailing slash mode (/users and /users/ are different routes)
function createStrictApp(): VitoApp {
    let app: VitoApp;
    app.init();
    app.setStrictSlash(true);
    return app;
}

function runVitoApp(port: number): void {
    let app = createApp();
    app.any("/health", (req: Request, res: Response) => {
        res.json("{\"status\":\"UP\",\"framework\":\"Vito v1.2.0\",\"engine\":\"VIT Native Phase 9\",\"routes\":32,\"middlewares\":8,\"namedRoutes\":16}");
    });
    app.listen(port);
}
