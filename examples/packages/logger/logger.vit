// Vito Logger Middleware Plugin (vito/packages/logger/logger.vit)
import { Request, Response } from "../../src/vito.vit";

function loggerMiddleware(req: Request, res: Response): boolean {
    if (req.queryString.length > 0) {
        print("[Vito Logger] " + req.method + " " + req.path + "?" + req.queryString);
    } else {
        print("[Vito Logger] " + req.method + " " + req.path);
    }
    return true; // Continue pipeline
}

function logRequest(method: string, path: string): void {
    print("[Vito Logger] " + method + " " + path);
}
