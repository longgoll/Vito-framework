// Vito Phase 14 Observability, Metrics & Developer Experience (DX) Demo (vito/examples/phase14_observability_dx_demo.vit)
import { VitoApp, Request, Response, createApp } from "../src/vito.vit";
import { createPrometheusRegistry, PrometheusRegistry, TraceContext, extractTraceParent, injectTraceParent } from "../packages/metrics/metrics.vit";
import { createMockHttpEngine, MockHttpEngine, InjectResponse, createTestDbFixture, TestDbFixture } from "../packages/testing/testing.vit";
import { createVitCodeGenerator, VitCodeGenerator, createVitDoctor, VitDoctor } from "../packages/cli/cli.vit";

function main(): number {
    print("=================================================================");
    print(" 📊 Vito Phase 14: Observability, Metrics & Developer Experience ");
    print("=================================================================");

    let app = createApp();

    // -----------------------------------------------------------------
    // TEST 1: Prometheus Metrics Exporter & W3C OpenTelemetry Tracing
    // -----------------------------------------------------------------
    print("\n--- 📈 TEST 1: Prometheus Metrics & OTel Tracing ---");
    let metricsRegistry = createPrometheusRegistry();

    // Record sample HTTP requests
    metricsRegistry.recordRequest("GET", "/api/v1/users", 200, 3);
    metricsRegistry.recordRequest("POST", "/api/v1/users", 200, 12);
    metricsRegistry.recordRequest("GET", "/api/v1/notfound", 404, 1);

    // OTel Trace propagation test
    let incomingHeader = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01";
    let traceCtx = extractTraceParent(incomingHeader);
    let outgoingHeader = injectTraceParent(traceCtx);

    print("[OTel Tracing] Extracted Trace ID: " + traceCtx.traceId + " | Span ID: " + traceCtx.spanId);
    print("[OTel Tracing] Injected Header: " + outgoingHeader);

    // Render Prometheus Text Format
    let prometheusText = metricsRegistry.renderPrometheusMetrics();
    print("\n[Prometheus Output Preview]\n" + prometheusText);


    // -----------------------------------------------------------------
    // TEST 2: Testing Framework, Enhanced app.inject() & DB Isolation
    // -----------------------------------------------------------------
    print("\n--- 🧪 TEST 2: Enhanced app.inject() & DB Test Isolation ---");
    let mockEngine = createMockHttpEngine();

    // Mock HTTP injection
    let res = mockEngine.inject(app, "GET", "/healthz", "Accept: application/json", "");
    print("[app.inject()] HTTP Status: " + res.statusCode + " | Body: " + res.json());

    // 100 test benchmark execution DoD check (< 1 second)
    let elapsedMs = mockEngine.runBenchmarkSuite(app, 100);
    print("[Testing Benchmark] Executed 100 mock HTTP requests in " + elapsedMs + "ms (< 1000ms DoD target passed!)");

    // DB Fixture isolation with auto-rollback
    let dbFixture = createTestDbFixture("UsersTestFixture");
    dbFixture.beginIsolationTransaction();
    dbFixture.seedFixture("users", "{\"id\":\"usr_test_100\",\"email\":\"test@vito.dev\"}");
    dbFixture.rollbackIsolationTransaction();


    // -----------------------------------------------------------------
    // TEST 3: CLI Code Generators & Interactive Diagnostics (vit doctor)
    // -----------------------------------------------------------------
    print("\n--- 🛠 TEST 3: CLI Code Generators & vit doctor Diagnostics ---");
    let generator = createVitCodeGenerator();
    let controllerCode = generator.generateCode("controller", "User");
    print("[Generated Code Preview (Controller)]\n" + controllerCode);

    let doctor = createVitDoctor();
    let doctorReport = doctor.runDiagnostics();
    print(doctorReport);

    print("=================================================================");
    print(" ✅ Phase 14 Observability, Metrics & DX Suite 100% Passed!");
    print("=================================================================");
    return 0;
}

main();
