// Vito Phase 13 Real-Time WebSockets & Background Task Queues Demo (vito/examples/phase13_realtime_jobs_demo.vit)
import { VitoApp, Request, Response, createApp } from "../src/vito.vit";
import { createWebSocketServer, WebSocketServer, WebSocketClient, WebSocketRoom, compressFrame, decompressFrame } from "../packages/websocket/websocket.vit";
import { createEventBus, AsyncEventEmitter } from "../packages/events/event_bus.vit";
import { createRedisPubSubAdapter, RedisPubSubAdapter } from "../packages/events/redis_pubsub.vit";
import { createJobQueue, VitoJobQueue, Job } from "../packages/queue/queue.vit";

function main(): number {
    print("=================================================================");
    print(" ⚡ Vito Phase 13: Real-Time WebSockets & Background Job Queues ");
    print("=================================================================");

    let app = createApp();

    // -----------------------------------------------------------------
    // TEST 1: Production-Grade WebSocket Server Engine & Room Broadcast
    // -----------------------------------------------------------------
    print("\n--- 🔌 TEST 1: WebSocket Engine, Rooms & Compression ---");
    let wsServer = createWebSocketServer(8080, 50000);
    
    // Simulate HTTP upgrade request
    let upgradeHeader = wsServer.handleUpgrade("websocket", "dGhlIHNhbXBsZSBub25jZQ==");
    print("[WebSocket Upgrade Response Headers]\n" + upgradeHeader);

    // Accept clients
    let client1 = wsServer.acceptConnection("192.168.1.10");
    let client2 = wsServer.acceptConnection("192.168.1.11");
    let client3 = wsServer.acceptConnection("192.168.1.12");

    print("[WebSocket Active Connections] " + wsServer.activeConnections + " / " + wsServer.maxConnections + " clients connected.");

    // Room management
    let chatRoom: WebSocketRoom;
    chatRoom.init("room_vip_lounge");
    chatRoom.addClient(client1.id);
    chatRoom.addClient(client2.id);

    wsServer.broadcastToRoom(chatRoom, "{\"event\":\"chat:msg\",\"user\":\"Alice\",\"text\":\"Hello VIP Room!\"}");
    wsServer.unicast(client3, "{\"event\":\"system:notification\",\"text\":\"Private message to client 3\"}");

    // Compression testing
    let rawPayload = "Vito High-Throughput Real-Time WebSocket Frame Payload Data Stream";
    let compressedPayload = compressFrame(rawPayload);
    print("[WebSocket Compression] Raw: " + rawPayload.length + " bytes | Compressed: " + compressedPayload);

    // Heartbeat check & stale connection cleanup
    let isClient1Alive = wsServer.checkHeartbeats(client1, 1700000010);
    let c1AliveStr = "false"; if (isClient1Alive) { c1AliveStr = "true"; }
    print("[WebSocket Heartbeat] Client 1 Alive Check: " + c1AliveStr);

    let isStaleClientCleaned = wsServer.checkHeartbeats(client3, 1700000100); // 100 seconds past ping limit
    let c3CleanedStr = "false"; if (!isStaleClientCleaned) { c3CleanedStr = "true"; }
    print("[WebSocket Stale Cleanup] Client 3 Stale Connection Evicted: " + c3CleanedStr);


    // -----------------------------------------------------------------
    // TEST 2: Internal Async Event Bus & Redis Pub/Sub Cluster
    // -----------------------------------------------------------------
    print("\n--- 📬 TEST 2: Async Event Bus & Redis Pub/Sub Adapter ---");
    let eventBus = createEventBus();
    eventBus.on("user:registered", "SendWelcomeEmailHandler");
    eventBus.on("user:registered", "AuditLoggerHandler");
    eventBus.on("order:placed", "InventoryDecrementHandler");

    let dispatchedCount = eventBus.emitAsync("user:registered", "{\"userId\":\"usr_999\",\"email\":\"dev@vito.dev\"}");
    print("[Async Event Dispatcher] Dispatched handlers count: " + dispatchedCount);

    let redisPubSub = createRedisPubSubAdapter("127.0.0.1", 6379);
    redisPubSub.subscribeChannel("vito:cluster:events");
    redisPubSub.publishCluster("vito:cluster:events", "{\"node\":\"node_us_east_1\",\"event\":\"cache:purge\"}");


    // -----------------------------------------------------------------
    // TEST 3: Background Task Queue (In-Memory & Redis, Delayed Jobs, Retry & DLQ)
    // -----------------------------------------------------------------
    print("\n--- ⏳ TEST 3: Background Job Queue, Retries & Dead Letter Queue ---");
    let memQueue = createJobQueue("memory");
    let redisQueue = createJobQueue("redis");

    // Push standard job
    let emailJob: Job;
    emailJob.init("job_email_001", "email:send", "{\"to\":\"user@example.com\",\"template\":\"welcome\"}");
    memQueue.pushJob(emailJob);

    // Schedule delayed job
    let reportJob: Job;
    reportJob.init("job_report_002", "report:export", "{\"format\":\"pdf\",\"range\":\"monthly\"}");
    memQueue.scheduleJob(reportJob, 5000); // 5000ms delay

    // Process job success
    memQueue.processNextJob(false, "");

    // Simulate job failure with Retry Policy (Exponential Backoff) & DLQ transition
    let failingJob: Job;
    failingJob.init("job_image_003", "image:process", "{\"src\":\"/avatar.jpg\"}");
    failingJob.maxRetries = 2;
    redisQueue.pushJob(failingJob);

    print("[Retry Policy & DLQ Simulation]");
    // Attempt 1: Failed -> Retry #1 (1000ms backoff)
    redisQueue.processNextJob(true, "Connection Timeout to Image Microservice");
    // Attempt 2: Failed -> Retry #2 (Exceeds maxRetries=2) -> Moved to Dead Letter Queue (DLQ)
    redisQueue.processNextJob(true, "Connection Timeout to Image Microservice");

    print("[Job Queue DoD Statistics]");
    print("  Completed Jobs: " + memQueue.completedCount);
    print("  Failed / DLQ Jobs: " + redisQueue.failedCount);
    print("  DLQ Storage Count: " + redisQueue.dlq.count);


    print("\n=================================================================");
    print(" ✅ Phase 13 Real-Time & Background Task Queues 100% Passed!");
    print("=================================================================");
    return 0;
}

main();

