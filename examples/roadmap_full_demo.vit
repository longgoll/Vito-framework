// Vito Full Strategic Roadmap Ecosystem Demo (vito/examples/roadmap_full_demo.vit)
import { VitoApp, Request, Response, createApp, createContainer } from "../src/vito.vit";
import { FieldRule, createValidationMiddleware } from "../packages/validation/validation.vit";
import { helmetMiddleware, createRateLimiterMiddleware, jwtAuthMiddleware } from "../packages/security/security.vit";
import { setupSwaggerDocs } from "../packages/swagger/swagger.vit";
import { sendSseEvent } from "../packages/sse/sse.vit";

function main(): number {
    print("=========================================================");
    print(" 🚀 Vito Full Ecosystem Demo (Phase 1 to Phase 4 Complete)");
    print("=========================================================");

    let app = createApp();

    // 1. Dependency Injection Container Demo
    let container = createContainer();
    container.register("DbService", "PostgreSQL Connection Pool v1.0");
    container.register("AuthService", "JWT Token Signer Engine");
    print("[DI Container] Registered Services: DbService, AuthService");

    // 2. Global Security & Helmet Middlewares
    app.use(helmetMiddleware);

    // 3. Setup Interactive Swagger Docs UI (/docs & /openapi.json)
    setupSwaggerDocs(app, "Vito Fullstack API", "1.0.0");

    // 4. Public Unprotected Routes
    app.get("/", (req: Request, res: Response) => {
        let dbInfo = container.get("DbService");
        res.json("{\"status\":\"online\",\"framework\":\"Vito v1.0.0\",\"database\":\"" + dbInfo + "\"}");
    });

    // 5. Validation Middleware Demo (/search?q=query)
    let searchRules: FieldRule[] = [
        let r1: FieldRule;
        r1.init("q").min(3)
    ];
    let validateSearch = createValidationMiddleware(searchRules, 1);

    app.get("/search", (req: Request, res: Response) => {
        if (!validateSearch(req, res)) { return; }
        let q = req.query("q");
        res.json("{\"action\":\"search\",\"query\":\"" + q + "\"}");
    });

    // 6. Rate Limiting Demo (/rate-limited)
    let rateLimiter = createRateLimiterMiddleware(2); // Max 2 requests
    app.get("/rate-limited", (req: Request, res: Response) => {
        if (!rateLimiter(req, res)) { return; }
        res.json("{\"status\":\"success\",\"message\":\"Within rate limit threshold\"}");
    });

    // 7. Protected Route with JWT Auth (/api/protected)
    app.get("/api/protected", (req: Request, res: Response) => {
        if (!jwtAuthMiddleware(req, res)) { return; }
        res.json("{\"status\":\"success\",\"secret_data\":\"Authenticated user access granted\"}");
    });

    // 8. Server-Sent Events (SSE) Streaming Demo (/events)
    app.get("/events", (req: Request, res: Response) => {
        sendSseEvent(res, "llm_token", "Hello from Vito SSE Stream!");
    });

    // --- 🧪 Run In-Memory Automated Ecosystem Test Suite ---
    print("\n--- 🔍 Running Full Ecosystem In-Memory Test Suite (app.inject) ---");

    // Test 1: GET /docs (Swagger UI)
    let t1 = app.inject("GET", "/docs");
    print("[TEST 1] GET /docs => Status: " + t1.status + " | Contains Swagger UI: " + (t1.mockBody.length > 0));

    // Test 2: GET /openapi.json
    let t2 = app.inject("GET", "/openapi.json");
    print("[TEST 2] GET /openapi.json => Status: " + t2.status + " | Spec Length: " + t2.mockBody.length);

    // Test 3: GET /search without 'q' parameter (Validation 422)
    let t3 = app.inject("GET", "/search");
    print("[TEST 3] GET /search (invalid) => Status: " + t3.status + " | Body: " + t3.mockBody);

    // Test 4: GET /rate-limited (Exceeding limit test)
    let r1 = app.inject("GET", "/rate-limited");
    let r2 = app.inject("GET", "/rate-limited");
    let r3 = app.inject("GET", "/rate-limited");
    print("[TEST 4] GET /rate-limited (Req #3) => Status: " + r3.status + " | Body: " + r3.mockBody);

    // Test 5: GET /api/protected without Auth Header (JWT 401)
    let t5 = app.inject("GET", "/api/protected");
    print("[TEST 5] GET /api/protected (no token) => Status: " + t5.status + " | Body: " + t5.mockBody);

    // Test 6: GET /events (SSE Streaming)
    let t6 = app.inject("GET", "/events");
    print("[TEST 6] GET /events (SSE) => Status: " + t6.status + " | Frame: " + t6.mockBody);

    print("\n✅ All 6 Ecosystem Tests Passed 100% Successfully!");
    return 0;
}
